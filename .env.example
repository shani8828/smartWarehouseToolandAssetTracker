# Local MongoDB (default) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/smart_warehouse
# Long random string used to sign login sessions
SESSION_SECRET=change-me
# Shared secret for the /api/cron/overdue endpoint
CRON_SECRET=change-me
APP_URL=http://localhost:3000
# Optional SMTP. Leave SMTP_HOST empty to keep emails in preview mode (shown on the Alerts page).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smart Warehouse <no-reply@example.com>"
